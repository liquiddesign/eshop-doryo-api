{
    "name": "liquiddesign/eshop-doryo-api",
    "description": "Čtecí API e-shopu pro Doryo — objednávky, zákazníci, produkty, sklad a faktury v jednotné projekci",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "liquiddesign/eshop": "^2.0",
        "liquiddesign/storm": "^1.1 || ^2.0",
        "nette/application": "^3.1 || ^3.2",
        "nette/di": "^3.1 || ^3.2",
        "nette/http": "^3.2 || ^3.3",
        "nette/schema": "^1.2 || ^1.3",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "DoryoApi\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "liquiddesign/codestyle": "^3.0",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-nette": "^1.3"
    },
    "scripts": {
        "phpcs": "phpcs --standard=ruleset.xml --cache ./src",
        "phpcsfix": "phpcbf --standard=ruleset.xml --cache ./src",
        "phpstan": "phpstan analyse --memory-limit 2G -c phpstan.neon",
        "check-code": [
            "@phpcs",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
